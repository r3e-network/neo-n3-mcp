# Neo N3 MCP example environment.
#
# Copy to .env and edit. .env is git-ignored; never commit real secrets.
# Every variable below is optional unless marked REQUIRED, and the value shown
# is the built-in default. See README.md and docs/ for full descriptions.
#
# This package has three entrypoints with separate configuration:
#   npm start            MCP stdio         (no listener; the client spawns it)
#   npm run start:mcp-http   MCP 2026-07-28 HTTP -> MCP_HTTP_* below
#   npm run start:http       REST API (not MCP)   -> HTTP_* and PORT below
# See docs/remote-mcp-transport.md for the distinction.

# ---------------------------------------------------------------------------
# Neo network and RPC (shared by all entrypoints)
# ---------------------------------------------------------------------------

# mainnet | testnet | both. The REST entrypoint rejects "both".
NEO_NETWORK=both

NEO_MAINNET_RPC=https://mainnet1.neo.coz.io:443
NEO_TESTNET_RPC=https://testnet1.neo.coz.io:443

# Per-operation Neo RPC deadline in milliseconds.
NEO_RPC_TIMEOUT_MS=15000

# Allow a remote plaintext HTTP RPC URL. Keep false outside controlled
# development environments; remote RPC endpoints should use HTTPS.
NEO_ALLOW_INSECURE_RPC=false

# Maximum combined system and network fee for a signed transaction, in GAS.
NEO_MAX_TRANSACTION_FEE_GAS=20

# ---------------------------------------------------------------------------
# Remote MCP transport (MCP 2026-07-28) -- npm run start:mcp-http
# ---------------------------------------------------------------------------

MCP_HTTP_PORT=3001

# Listen address. Keep on loopback unless a reverse proxy must reach it.
MCP_HTTP_HOST=127.0.0.1

# Path serving stateless POST requests and OPTIONS preflight. Clients use the
# full URL, e.g.
# http://127.0.0.1:3001/mcp
MCP_HTTP_PATH=/mcp

# REQUIRED when MCP_HTTP_HOST is not a loopback address, where it must also
# contain at least 32 bytes. Generate with:
#   openssl rand -hex 32
# Clients send it as: Authorization: Bearer <token>
# MCP_HTTP_BEARER=

# Comma-separated exact-origin allowlist for browser clients. Any request
# carrying an Origin header is rejected unless that origin is listed, so the
# empty default rejects every browser. Server-side clients send no Origin
# header and are always allowed.
# MCP_HTTP_ALLOWED_ORIGINS=https://explorer.example.com

# Optional comma-separated Host-header allowlist (second DNS-rebinding defense).
# Empty accepts any Host (correct behind a reverse proxy). Set only for a
# directly-exposed listener that should answer for specific hostnames.
# MCP_HTTP_ALLOWED_HOSTS=mcp.example.com

# Maximum in-flight MCP requests accepted by one process.
MCP_HTTP_MAX_CONCURRENT_REQUESTS=128

# Maximum concurrent subscriptions/listen streams.
MCP_HTTP_MAX_SUBSCRIPTIONS=128

# Maximum POST body size in bytes (4 MiB).
MCP_HTTP_MAX_BODY_BYTES=4194304

# Request transport deadlines and subscription keepalive interval.
MCP_HTTP_BODY_TIMEOUT_MS=30000
MCP_HTTP_HEADERS_TIMEOUT_MS=30000
MCP_HTTP_REQUEST_TIMEOUT_MS=300000
MCP_HTTP_KEEP_ALIVE_MS=15000

# ---------------------------------------------------------------------------
# REST API (not MCP) -- npm run start:http
# ---------------------------------------------------------------------------

PORT=3000
HTTP_HOST=127.0.0.1

# REQUIRED when HTTP_HOST is not a loopback address. At least 32 bytes.
# HTTP_API_KEY=

# Comma-separated exact HTTP/HTTPS origins. Wildcards are not supported.
# HTTP_CORS_ORIGINS=https://console.example.com

# Comma-separated trusted proxy addresses for client-IP resolution.
# HTTP_TRUSTED_PROXIES=

# Maximum request body size in bytes (1 MiB).
HTTP_MAX_BODY_BYTES=1048576

# ---------------------------------------------------------------------------
# Write operations (disabled by default; leave disabled for remote MCP)
# ---------------------------------------------------------------------------

# Registers state-changing tools and HTTP routes. Do not enable this on a
# remotely reachable listener.
NEO_ENABLE_WRITES=false

# Owner-only (0600) regular file holding the single server signer WIF.
# Required when NEO_ENABLE_WRITES=true. Keep it outside the repository.
# NEO_SIGNER_WIF_FILE=/run/secrets/neo-signer-wif

# Independent HMAC key for signed MCP 2026-07-28 multi-round-trip request
# state. Required when NEO_ENABLE_WRITES=true, at least 32 bytes, and must
# differ from every HTTP bearer/approval key.
# NEO_MCP_REQUEST_STATE_KEY=

# Durable idempotency journal directory.
# NEO_WRITE_STATE_DIR=/var/lib/neo-mcp/write-operations

# Independent bearer token for REST write approval. Required for writes and
# must differ from HTTP_API_KEY.
# HTTP_WRITE_APPROVAL_API_KEY=

# Enables REST wallet create/import administration.
NEO_ENABLE_WALLET_ADMIN=false

# ---------------------------------------------------------------------------
# Contract name resolution
# ---------------------------------------------------------------------------

N3INDEX_ENABLED=true
N3INDEX_API_BASE_URL=https://api.n3index.dev

# ---------------------------------------------------------------------------
# Storage, rate limiting, and logging
# ---------------------------------------------------------------------------

WALLETS_DIR=./wallets

RATE_LIMITING_ENABLED=true
MAX_REQUESTS_PER_MINUTE=60
MAX_REQUESTS_PER_HOUR=1000

# debug | info | warn | error
LOG_LEVEL=info
LOG_CONSOLE=true

# Setting LOG_FILE enables file logging; LOG_FILE_ENABLED turns it on using
# the default path.
LOG_FILE_ENABLED=false
# LOG_FILE=./logs/neo-mcp.log
