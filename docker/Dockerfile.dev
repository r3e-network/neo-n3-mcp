FROM node:22-alpine@sha256:4d64b49e6c891c8fc821007cb1cdc6c0db7773110ac2c34bf2e6960adef62ed3 AS development

WORKDIR /app

ENV NODE_ENV=development \
    NEO_NETWORK=testnet \
    HTTP_HOST=0.0.0.0 \
    PORT=3000 \
    WALLETS_DIR=/app/wallets \
    LOG_CONSOLE=true

COPY package.json package-lock.json tsconfig.json jest.config.js ./
RUN npm ci
COPY src ./src
COPY tests ./tests

RUN mkdir -p /app/wallets && chown node:node /app /app/wallets
USER node

EXPOSE 3000 9229
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD node -e "require('http').get('http://127.0.0.1:3000/live',res=>process.exit(res.statusCode===200?0:1)).on('error',()=>process.exit(1))"

CMD ["node", "--require", "ts-node/register", "src/http.ts"]
